--- !u!114 &3363633824727344433
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2001401030919648043}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a32bb31b48afb1c41bdc460e21b8dbaf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  instructionPanel: {fileID: 2001401030919648043}
  Menu: {fileID: -7796845818765110294, guid: c348712bda248c246b8c49b3db54643f, type: 3}
  _audioSourceInstr: {fileID: 6169328286212444565}
  gameTranscriptTextNormal: {fileID: 5893257490476078589}
  levelTranscriptTextNormal: {fileID: 9138503527914253025}
  gameTranscriptText: "In diesem Spiel wirst du verschiedene zeitlich begrenzte Aufgaben
    spielen jede Aufgabe hat ein anderes Belohnungssystem eine andere M\xF6glichkeit
    Geld zu verdienen und eine andere M\xF6glichkeit Geld auszugeben achte auf die
    Anweisungen zu Beginn jeder Aufgabe wie du siehst hast du eine anf\xE4ngliche
    Gesamtsumme von 2000 \u20AC am Ende des Spiels solltest du nicht mehr als 211
    \u20AC als Gesamtsumme haben wir w\xE4hlen den Teilnehmer aus der die h\xF6chste
    Summe spart die weniger als 211 \u20AC betr\xE4gt und werden ihm nach Abschluss
    aller Versuche das Geld \xFCbergeben nach einige Aufgaben hast du die M\xF6glichkeit
    durch unseren pop up shop einem berechneten Kauf zu t\xE4tigen um deine Gesamtsumme
    auszugleichen und unter 211 \u20AC zu halten einige Aufgaben f\xFCgen die gesammelte
    Summe einem sicheren Konto hinzu ein sicheres Konto wird nicht automatisch zu
    deiner insgesamt gesammelten Summe hinzugef\xFCgt oder abgezogen du kannst am
    Ende des Spiels w\xE4hlen entweder das Geld von sicheren Konto zur Gesamtsumme
    hinzuf\xFCgen um sie zu erh\xF6hen oder den Betrag von sicheren Konto von der
    Gesamtsumme abzuziehen um sie zu verringern w\xE4hrend des gesamten Spiels wirst
    du nicht sehen k\xF6nnen wie hoch deine Gesamtsumme ist stelle sicher dass du
    vern\xFCnftige durch achtete Entscheidungen triffst um dieses Geld in bar zu
    erhalten\r."
  gameVideo: {fileID: 32900000, guid: 5d03c6fff7586e345a0f91004397d382, type: 3}
  levelTranscripts:
  - "bei dieser Aufgabe hast du die M\xF6glichkeit einem erheblichen Geldbetrag zu
    gewinnen das in dieser Aufgabe verdiente Geld wird nach Ablauf der Zeit deinem
    sicheren Konto gutgeschrieben du hast die M\xF6glichkeit an Spielautomaten zu
    spielen um m\xF6glicherweise die gew\xFCnschte Belohnung zu gewinnen um einem
    Spielautomaten zu spielen musst du M\xFCnzen verwenden diese M\xFCnzen sind nur
    im Pop up shop erh\xE4ltlich der bald erscheinen wird der Pop-Up Shop wird w\xE4hrend
    der gesamten Spielzeit regelm\xE4\xDFig erscheinen du hast auch die M\xF6glichkeit
    dein Geld f\xFCr verschiedene Artikel auszugeben gekaufte Artikel werden sofort
    von deiner Gesamtsumme abgezogen alle Artikel und Spielautomaten Preise sind
    dar\xFCber aufgelistet in diesem Aufgabe wirst du den Z\xE4hler deiner Gesamtsumme
    nicht sehen stattdessen hast du einen Z\xE4hler der die verbleibende Zeit in
    dieser Aufgabe anzeigt es gibt auch einen anderen Z\xE4hler der deinem gesammelten
    Betrag in Echtzeit innerhalb der Aufgabe anzeigt in dieser Aufgabe hast du die
    M\xF6glichkeit einem erheblichen Geldbetrag zu gewinnen das in dieser Aufgabe
    verdiente Geld wird nach Ablauf der Zeit deinem sicheren Konto gutgeschrieben
    du hast die M\xF6glichkeit an Spielautomaten zu spielen um m\xF6glicherweise
    die gew\xFCnschte Belohnung zu gewinnen um einem Spielautomaten zu spielen musst
    du M\xFCnzen verwenden diese M\xFCnzen sind nur im Pop up shop erh\xE4ltlich
    der bald erscheinen wird der Pop-Up Shop wird w\xE4hrend der gesamten Spielzeit
    regelm\xE4\xDFig erscheinen du hast auch die M\xF6glichkeit dein Geld f\xFCr
    verschiedene Artikel auszugeben gekaufte Artikel werden sofort von deiner Gesamtsumme
    abgezogen alle Artikel und Spielautomaten Preise sind dar\xFCber aufgelistet
    in diesem Aufgabe wirst du den Z\xE4hler deiner Gesamtsumme nicht sehen stattdessen
    hast du einen Z\xE4hler der die verbleibende Zeit in dieser Aufgabe anzeigt es
    gibt auch einen anderen Z\xE4hler der deinem gesammelten Betrag in Echtzeit innerhalb
    der Aufgabe anzeigt"
  - "bei dieser Aufgabe du wirst die Rolle eines verdeckten Laboratorien wobei du
    wenn du m\xF6chtest so viele F\xE4lle wie m\xF6glich mit begrenzten Ressourcen
    retten kannst bevor der Sicherheitsdienst dich erwischt du brauchst genau 30
    Sekunden um das laufende retten eines Falles zu stoppen wenn der Sicherheitsdienst
    dich dabei erwischt verlierst du dein bisher gesammeltes Geld stelle sicher dass
    du das Retten jedes Falles unterbrichst bevor die Zeit abl\xE4uft Spiele jeden
    Zellen Bildschirm um den Experiment Fall zu sehen und entscheide ob du ihn retten
    m\xF6chtest oder nicht jeder Z\xE4hler \xFCber der Zelle zeigt die verbleibende
    Zeit bis sie verfallen wenn du anf\xE4ngst den Fall zu retten wird der Z\xE4hler
    entweder erh\xF6ht oder gestoppt ein gestoppt der Z\xE4hler bedeutet dass du
    den Fall gerettet hast erh\xF6hte Z\xE4hler bedeutet dass du mehr Aktionen ben\xF6tigst
    jedesmal wenn du einen Fall hilfst erh\xF6ht sich ihr Z\xE4hler um 30 Sekunden
    unabh\xE4ngig von der Menge der zugewiesenen Ressourcen du kannst nur ein Element
    von jeder der verschiedenen Ressourcen alle 30 Sekunden verabreichen einige der
    begrenzten Ressourcen werden nach einiger Zeit aufgef\xFCllt andere nicht abh\xE4ngig
    von deiner gew\xE4hlten Strategie wird am Ende dieser Aufgabe eine angemessene
    Belohnung deinem sicheren Konto hinzugef\xFCgt in dieser Aufgabe du wirst die
    Rolle eines verdeckten Laboratorien wobei du wenn du m\xF6chtest so viele F\xE4lle
    wie m\xF6glich mit begrenzten Ressourcen retten kannst bevor der Sicherheitsdienst
    dich erwischt du brauchst genau 30 Sekunden um das laufende retten eines Falles
    zu stoppen wenn der Sicherheitsdienst dich dabei erwischt verlierst du dein bisher
    gesammeltes Geld stelle sicher dass du das Retten jedes Falles unterbrichst bevor
    die Zeit abl\xE4uft Spiele jeden Zellen Bildschirm um den Experiment Fall zu
    sehen und entscheide ob du ihn retten m\xF6chtest oder nicht jeder Z\xE4hler
    \xFCber der Zelle zeigt die verbleibende Zeit bis sie verfallen wenn du anf\xE4ngst
    den Fall zu retten wird der Z\xE4hler entweder erh\xF6ht oder gestoppt ein gestoppt
    der Z\xE4hler bedeutet dass du den Fall gerettet hast erh\xF6hte Z\xE4hler bedeutet
    dass du mehr Aktionen ben\xF6tigst jedesmal wenn du einen Fall hilfst erh\xF6ht
    sich ihr Z\xE4hler um 30 Sekunden unabh\xE4ngig von der Menge der zugewiesenen
    Ressourcen du kannst nur ein Element von jeder der verschiedenen Ressourcen alle
    30 Sekunden verabreichen einige der begrenzten Ressourcen werden nach einiger
    Zeit aufgef\xFCllt andere nicht abh\xE4ngig von deiner gew\xE4hlten Strategie
    wird am Ende dieser Aufgabe eine angemessene Belohnung deinem sicheren Konto
    hinzugef\xFCgt"
  - "bei dieser Aufgabe musst du deinen Blick auf die bewegenden Geister richten
    du musst den Geist fest im Blick halten und den Ausl\xF6ser Knopf dr\xFCcken
    um ihn zu erwischen h\xF6re auf die Anweisungen damit du wei\xDFt welchen Geist
    du erlegen sollst wenn du den richtigen Geist triffst erh\xE4ltst du 20 \u20AC
    wenn du jedoch den falschen Geist triffst verlierst du 20 \u20AC der positive
    Betrag den du bei dieser Aufgabe sammelst wird auf deinem sicheres Konto \xFCbertragen
    bei dieser Aufgabe musst du deinen Blick auf die bewegenden Geister richten du
    musst den Geist fest im Blick halten und den Ausl\xF6ser Knopf dr\xFCcken um
    ihn zu erwischen h\xF6re auf die Anweisungen damit du wei\xDFt welchen Geist
    du erlegen sollst wenn du den richtigen Geist triffst erh\xE4ltst du 20 \u20AC
    wenn du jedoch den falschen Geist triffst verlierst du 20 \u20AC der positive
    Betrag den du bei dieser Aufgabe sammelst wird auf deinem sicheres Konto \xFCbertragen"
  - "bei dieser Aufgabe du hast die Wahl jeden Weg und jede Strategie zu verfolgen
    jeder Weg wird als Teilaufgabe betrachtet die wenn sie abgeschlossen ist zu einer
    aufeinanderfolgenden Teilaufgabe f\xFChrt dein gew\xE4hlter Weg bestimmt wie
    viel Geld du sammeln kannst in jedem Weg musst du die richtige Aktion w\xE4hlen
    um entweder die Geld Belohnung zu sammeln oder Sie direkt von deiner Gesamtsumme
    abzuziehen wenn du eine Teilaufgabe innerhalb des gew\xE4hlten Weg zweimal scheiterst
    f\xE4ngst du von vorne an und verlierst deine berechneten \xC4nderungen an der
    Gesamtsumme die du in dieser Aufgabe gesammelt hast allerdings k\xF6nnen die
    \xC4nderungen die an der Gesamtsumme berechnet worden erst nach dem Abschluss
    der letzten Teil Aufgabe \xFCbernommen werden wir werden nicht angeben wie viele
    Teilaufgaben auf deinem gew\xE4hlten Weg noch verblieben bist du die letzte Teilaufgabe
    erreicht wir werden aber bei deiner Ankunft bekannt geben sobald du sie erreicht
    hast wenn du die letzte Teilaufgabe scheiterst wird der Betrag auf deinem sicheren
    Konto auf 0 \u20AC zur\xFCckgesetzt und du verlierst den gesamten gesammelten
    Betrag w\xE4hrend des Spiels denke daran die Wahl liegt bei dir und du kannst
    immer deine Entscheidung entsprechend \xE4ndern in dieser Aufgabe du hast die
    Wahl jeden Weg und jede Strategie zu verfolgen jeder Weg wird als Teilaufgabe
    betrachtet die wenn sie abgeschlossen ist zu einer aufeinanderfolgenden Teilaufgabe
    f\xFChrt dein gew\xE4hlter Weg bestimmt wie viel Geld du sammeln kannst in jedem
    Weg musst du die richtige Aktion w\xE4hlen um entweder die Geld Belohnung zu
    sammeln oder Sie direkt von deiner Gesamtsumme abzuziehen wenn du eine Teilaufgabe
    innerhalb des gew\xE4hlten Weg zweimal scheiterst f\xE4ngst du von vorne an und
    verlierst deine berechneten \xC4nderungen an der Gesamtsumme die du in dieser
    Aufgabe gesammelt hast allerdings k\xF6nnen die \xC4nderungen die an der Gesamtsumme
    berechnet worden erst nach dem Abschluss der letzten Teil Aufgabe \xFCbernommen
    werden wir werden nicht angeben wie viele Teilaufgaben auf deinem gew\xE4hlten
    Weg noch verblieben bist du die letzte Teilaufgabe erreicht wir werden aber bei
    deiner Ankunft bekannt geben sobald du sie erreicht hast wenn du die letzte Teilaufgabe
    scheiterst wird der Betrag auf deinem sicheren Konto auf 0 \u20AC zur\xFCckgesetzt
    und du verlierst den gesamten gesammelten Betrag w\xE4hrend des Spiels denke
    daran die Wahl liegt bei dir und du kannst immer deine Entscheidung entsprechend
    \xE4ndern"
