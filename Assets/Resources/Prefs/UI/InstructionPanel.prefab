  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In diesem Spiel werden Sie verschiedene zeitlich begrenzte Aufgaben spielen.
    Jede Aufgabe dauert mindestens 5 Minuten. \r\nJede Aufgabe hat ein eigenes Belohnungssystem,
    verschiedene M\xF6glichkeiten, Geld zu verdienen, und unterschiedliche Wege,
    Geld zu verlieren. \r\nAchten Sie genau auf die Anweisungen zu Beginn jeder Aufgabe.
    Sie werden nur einmal genannt und nicht wiederholt. \r\nSie starten mit einer
    anf\xE4nglichen Geldsumme von 2000 Euro. \r\nAm Ende des Spiels d\xFCrfen Sie
    insgesamt nicht mehr als 211 Euro besitzen. \r\nDer Teilnehmer, der die h\xF6chste
    Summe unter 211 Euro spart, erh\xE4lt diesen Betrag nach Abschluss aller Versuche
    in bar. \r\nZwischen den Aufgaben haben Sie die M\xF6glichkeit, durch unseren
    Pop-up-Shop gezielte K\xE4ufe zu t\xE4tigen, um Ihre Gesamtsumme auszugleichen
    und unter 211 Euro zu \r\nhalten. \r\nEinige Aufgaben belohnen Sie mit Geldbetr\xE4gen,
    die auf einem Sicheren Konto gespeichert werden. \r\nDas sichere Konto wird nicht
    automatisch zu Ihrer gesammelten Gesamtsumme hinzugef\xFCgt oder davon abgezogen.
    \r\nAm Ende des Spiels k\xF6nnen Sie das Geld vom sicheren Konto verwenden, um
    es zu Ihrer Gesamtsumme hinzuzuf\xFCgen oder davon abzuziehen. \r\nW\xE4hrend
    der Aufgaben k\xF6nnen Sie Ihre Gesamtsumme nicht einsehen. Sie sehen nur den
    w\xE4hrend der jeweiligen Aufgabe gesammelten Betrag. \r\nIhre Gesamtsumme k\xF6nnen
    Sie nur zwischen den Aufgaben im Pop-up-Shop einsehen. \r\nTreffen Sie wohl\xFCberlegte,
    kalkulierte Entscheidungen, um zu gewinnen und den Betrag in bar zu erhalten. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
