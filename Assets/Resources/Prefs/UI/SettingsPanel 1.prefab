--- !u!114 &3861331142390899757
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2707338660755883015}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 5
    m_MaxSize: 50
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Empfehlung:\nNach jeder Aufgabe werden die gesammelten Messwerte in einer
    JSON-Datei gespeichert. \nDie entsprechenden Daten jeder Aufgabe werden in unser
    LLM-Modell eingespeist, um die Messungen zu analysieren und die Werte den Ergebnissen
    der UPPS, des Big Five Inventory und des 30-Item-Fragebogens BIS-11 zuzuordnen.\n\nAm
    Ende werden alle Ergebnisse der verschiedenen Aufgaben in unser kollektives Messmodell
    eingespeist, welches die finale Messung und das Ergebnis berechnet, an dem wir
    interessiert sind. Dieser Ansatz wurde gew\xE4hlt, um Verzerrungen entgegenzuwirken,
    die durch Ausrei\xDFer, falsch zugewiesene Gewichtungen oder fehlerhafte Normalisierungen
    zu extremen Werten oder Abweichungen vom tats\xE4chlichen psychologischen Profil
    f\xFChren k\xF6nnten.\n\nDaher empfehlen wir, dass die Teilnehmer alle vier Aufgaben
    mit einer Mindestdauer von jeweils f\xFCnf Minuten durchlaufen."
