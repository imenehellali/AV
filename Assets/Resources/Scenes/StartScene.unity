  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Diese Umgebung ist eine VR-Umgebung mit zeitlich begrenzten Aufgaben,
    die eine gewisse Vertrautheit mit den Controllern erfordert. \n\nIn dieser Etage
    k\xF6nnen Sie alle Tasten des Controllers frei ausprobieren und lernen, wie Sie
    mit der Benutzeroberfl\xE4che interagieren. Gehen Sie zu den beiden Staffeleien
    und folgen Sie den Anweisungen daneben. Im oberen Stockwerk befindet sich unsere
    Trainingsarena. Gehen Sie die Treppe hoch und folgen Sie den Anweisungen neben
    jeder Station. Am Ende versuchen Sie, vom zweiten Stockwerk in den ersten zu
    springen und auf den roten Markierungen am Boden zu landen. Wenn Sie sich bereit
    f\xFChlen, dr\xFCcken Sie die Men\xFCtaste auf dem linken Controller, um die
    Aufgabe zu starten!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
